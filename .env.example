# Public site URL (used for canonical URLs, sitemap and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://dazzlecare.com.bd

# Google Analytics 4 — Measurement ID (G-XXXXXXX)
NEXT_PUBLIC_GA_ID=
# GA4 Admin → Data streams → Measurement Protocol API secrets (server-side lead tracking)
GA_API_SECRET=

# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# Events Manager → Settings → Conversions API → Generate access token
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager → Test events code, remove in production
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v23.0

# Search Console / Meta Business domain verification
GOOGLE_SITE_VERIFICATION=
FACEBOOK_DOMAIN_VERIFICATION=

# Where booking leads are POSTed as JSON (Google Apps Script, Zapier, Make, n8n, CRM...)
LEAD_WEBHOOK_URL=

# Dazzle Commerce API (categories & images)
API_URL=https://apix.bigpoint.com.bd

# Session signing secret — 32+ random chars, REQUIRED in production
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Where password-reset emails are sent as JSON {to, name, link, subject} (Resend/SendGrid/n8n...)
RESET_EMAIL_WEBHOOK_URL=
# Secret for POST /api/revalidate (clears cached categories/brands instantly)
REVALIDATE_SECRET=

# Absolute folder for users/orders JSON (production)
DATA_DIR=
# Set to 1 when nginx/Cloudflare handles compression
DISABLE_NEXT_COMPRESSION=

