# nginx in front of Next.js — offloads compression, static files and image
# re-requests from Node so the app server stays mostly idle.
# Copy to /etc/nginx/sites-available/dazzlecare and adjust paths/domain.

# Cache for optimized images and prerendered pages (survives restarts)
proxy_cache_path /var/cache/nginx/dazzlecare levels=1:2 keys_zone=dazzle:50m max_size=2g inactive=30d use_temp_path=off;

# Basic abuse protection
limit_req_zone $binary_remote_addr zone=track:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=actions:10m rate=5r/s;

upstream dazzle_app {
  server 127.0.0.1:3000;
  keepalive 32;
}

server {
  listen 80;
  server_name dazzlecare.com.bd www.dazzlecare.com.bd;
  # (add listen 443 ssl + certificates via certbot)

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_vary on;
  gzip_proxied any;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml text/xml application/manifest+json;
  # brotli on; brotli_comp_level 5; brotli_types ...;   # if ngx_brotli is installed

  # Hashed build assets — served straight from disk, never touch Node
  location /_next/static/ {
    alias /var/www/dazzlecare/.next/standalone/.next/static/;
    expires 1y;
    access_log off;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # Optimized images — encoded once by Next, then served from nginx cache
  location /_next/image {
    proxy_pass http://dazzle_app;
    proxy_cache dazzle;
    proxy_cache_valid 200 30d;
    proxy_cache_use_stale error timeout updating;
    proxy_cache_lock on;
    add_header X-Cache $upstream_cache_status;
    access_log off;
  }

  location = /api/track {
    limit_req zone=track burst=20 nodelay;
    client_max_body_size 4k;
    proxy_pass http://dazzle_app;
    access_log off;
  }

  location / {
    limit_req zone=actions burst=40 nodelay;
    client_max_body_size 1m;
    proxy_pass http://dazzle_app;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
  }
}
